# Cadena de conexión del pooler de Supabase para el servidor de Next.js.
# Configurar solo como variable privada en Vercel; nunca usar NEXT_PUBLIC_.
SUPABASE_DATABASE_URL="postgresql://postgres.PROJECT_REF:CLAVE@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require"

# Contraseña que autoriza la carga de nuevos archivos desde el dashboard.
UPLOAD_PASSWORD="cambia-esta-clave"
